SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# For local dev without Docker: postgres://neo_user:neo_password@localhost:5432/neo_sheet
# For Docker Compose (service name is 'db'): postgres://neo_user:neo_password@db:5432/neo_sheet
DATABASE_URL=postgres://neo_user:neo_password@db:5432/neo_sheet

# ---- Cache (Redis) ----
# Format: redis://HOST:PORT/DB_NUMBER
# For Docker Compose (service name is 'redis'): redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# ---- Email ----
# Development: emails are printed to the console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: use SMTP (uncomment and fill)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=no-reply@example.com