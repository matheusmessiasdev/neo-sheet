# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=your-domain.example.com

# Generate password with: openssl rand -base64 32
POSTGRES_USER=neo_sheet_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=neo_sheet
POSTGRES_HOST=db
POSTGRES_PORT=5432


REDIS_URL=redis://redis:6379/0


EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@your-domain.example.com

# (prod: True; test: False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True